<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pied Piper — Code Editor (self-made)</title>
<link rel="stylesheet" href="styles.css" />
<style>
  .ed-wrap{display:flex;flex-direction:column;height:100vh;background:#0c0c0e;color:#e4e4e7;font-family:'JetBrains Mono',ui-monospace,monospace}
  .ed-bar{display:flex;align-items:center;gap:4px;padding:4px 8px;background:#121214;border-bottom:1px solid #27272a;overflow-x:auto;flex:none;user-select:none}
  .ed-bar .lbl{font-size:10px;color:rgba(245,158,11,.8);font-weight:700;padding:0 4px;text-transform:uppercase;letter-spacing:.08em;flex:none}
  .ed-bar button{padding:4px 8px;background:#1c1c22;color:#d4d4d8;border:1px solid #2e2e38;border-radius:4px;font-size:12px;font-family:inherit;flex:none;cursor:pointer}
  .ed-bar button:hover{background:rgba(245,158,11,.2);color:#fcd34d}
  .ed-bar button:active{transform:scale(.95);background:rgba(245,158,11,.3)}
  .ed-main{flex:1;display:flex;overflow:hidden;min-height:0;position:relative}
  .ed-lines{width:40px;background:#09090b;border-right:1px solid #27272a;user-select:none;overflow:hidden;flex:none;font-size:11px;pointer-events:none}
  @media(min-width:640px){.ed-lines{width:56px;font-size:13px}}
  .ed-lines-inner{padding:16px 8px 128px 0;text-align:right;color:#71717a}
  .ed-lines-inner div{height:24px;line-height:24px;font-size:10px;opacity:.6}
  @media(min-width:640px){.ed-lines-inner div{font-size:12px}}
  .ed-lines-inner div.cur{color:#fbbf24;font-weight:700;background:rgba(245,158,11,.15);margin-right:-8px;padding-right:8px;border-radius:4px 0 0 4px;opacity:1}
  .ed-code{flex:1;min-width:0;background:#0c0c0e;position:relative}
  .ed-code textarea{width:100%;height:100%;padding:16px 12px 128px;background:transparent;color:#e4e4e7;resize:none;outline:none;font-family:inherit;font-size:12px;line-height:24px;white-space:pre;overflow:auto;display:block;border:0}
  @media(min-width:640px){.ed-code textarea{font-size:13px;padding-left:16px;padding-right:16px}}
  .ed-code textarea::placeholder{color:#3f3f46}
  .ed-foot{height:28px;background:#09090b;border-top:1px solid #27272a;padding:0 12px;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:#a1a1aa;user-select:none;flex:none}
  @media(min-width:640px){.ed-foot{font-size:11px}}
  .ed-foot .lang{display:flex;align-items:center;gap:6px;color:#fbbf24;font-weight:600}
  .ed-foot .lang i{width:6px;height:6px;border-radius:50%;background:#fbbf24;display:inline-block}
  .ed-foot select{background:#1c1c22;color:#fbbf24;border:1px solid #2e2e38;border-radius:4px;font-size:10px;font-family:inherit;padding:1px 4px}
  .ed-top{display:flex;align-items:center;gap:12px;padding:8px 12px;background:#09090b;border-bottom:1px solid #27272a;font-size:12px;flex:none}
  .ed-top a{color:#a4e86a;text-decoration:none}
  .ed-top span{color:#52525b}
</style>
</head>
<body>
<div class="ed-wrap">
  <div class="ed-top"><a href="index.html">← Pied Piper</a><span>self-made code editor · draft autosaves locally</span></div>
  <div class="ed-bar" id="quickbar"><span class="lbl">Quick Insert:</span></div>
  <div class="ed-main">
    <div class="ed-lines" id="lines"><div class="ed-lines-inner" id="linesInner"></div></div>
    <div class="ed-code"><textarea id="code" spellcheck="false" autocomplete="off" autocapitalize="none" autocorrect="off" placeholder="// Start coding..."></textarea></div>
  </div>
  <div class="ed-foot">
    <div style="display:flex;align-items:center;gap:12px">
      <span class="lang"><i></i><select id="lang"><option value="javascript">JAVASCRIPT</option><option value="typescript">TYPESCRIPT</option><option value="python">PYTHON</option><option value="html">HTML</option><option value="css">CSS</option></select></span>
      <span id="pos">Ln 1, Col 1</span>
    </div>
    <div style="display:flex;gap:12px;color:#71717a"><span id="statLines">1 lines</span><span id="statChars">0 chars</span><span>UTF-8</span></div>
  </div>
</div>
<script>
(function () {
  var QUICK = [
    ["Tab", "  "], ["{ }", "{\n  \n}"], ["( )", "()"], ["[ ]", "[]"],
    ["< >", "<>"], ['" "', '""'], ["' '", "''"], ["` `", "``"],
    ["=>", " => "], [";", ";"], ["=", " = "], ["/", "/"],
    ["const", "const "], ["function", "function "], ["return", "return "],
    ["console.log", "console.log();"]
  ];
  var ta = document.getElementById("code");
  var linesBox = document.getElementById("lines");
  var linesInner = document.getElementById("linesInner");
  var posEl = document.getElementById("pos");
  var statLines = document.getElementById("statLines");
  var statChars = document.getElementById("statChars");
  var langSel = document.getElementById("lang");
  var bar = document.getElementById("quickbar");
  var KEY = "pp-editor-draft";

  try {
    var saved = JSON.parse(localStorage.getItem(KEY) || "{}");
    if (saved.code) ta.value = saved.code;
    if (saved.lang) langSel.value = saved.lang;
  } catch (e) { /* fresh start */ }

  function save() {
    try { localStorage.setItem(KEY, JSON.stringify({ code: ta.value, lang: langSel.value })); } catch (e) {}
  }

  QUICK.forEach(function (s) {
    var b = document.createElement("button");
    b.type = "button";
    b.textContent = s[0];
    b.onclick = function () { insertSymbol(s[1]); };
    bar.appendChild(b);
  });

  function render() {
    var before = ta.value.substring(0, ta.selectionStart || 0).split("\n");
    var line = before.length, col = before[before.length - 1].length + 1;
    var count = Math.max(1, ta.value.split("\n").length);
    var html = "";
    for (var i = 1; i <= count; i++) {
      html += '<div class="' + (i === line ? "cur" : "") + '">' + i + "</div>";
    }
    linesInner.innerHTML = html;
    posEl.textContent = "Ln " + line + ", Col " + col;
    statLines.textContent = count + " lines";
    statChars.textContent = ta.value.length + " chars";
  }

  function insertSymbol(text) {
    var start = ta.selectionStart || 0, end = ta.selectionEnd || 0;
    ta.value = ta.value.substring(0, start) + text + ta.value.substring(end);
    requestAnimationFrame(function () {
      ta.focus();
      var p = start + text.length;
      ta.setSelectionRange(p, p);
      render();
    });
    save();
  }

  ta.addEventListener("input", function () { render(); save(); });
  ta.addEventListener("keyup", render);
  ta.addEventListener("click", render);
  ta.addEventListener("scroll", function () { linesBox.scrollTop = ta.scrollTop; });
  ta.addEventListener("keydown", function (e) {
    if (e.key === "Tab") {
      e.preventDefault();
      var start = ta.selectionStart, end = ta.selectionEnd;
      ta.value = ta.value.substring(0, start) + "  " + ta.value.substring(end);
      requestAnimationFrame(function () {
        ta.selectionStart = ta.selectionEnd = start + 2;
        render();
      });
      save();
    }
  });
  langSel.addEventListener("change", save);

  // Self-building workstation: with no saved draft, open the maker's own
  // component source (CodeEditor.tsx, committed verbatim) for editing.
  var hadDraft = !!(ta.value && ta.value.length);
  if (!hadDraft) {
    fetch("CodeEditor.tsx").then(function (res) {
      if (!res.ok) throw new Error("no source");
      return res.text();
    }).then(function (src) {
      if (ta.value && ta.value.length) return; // user typed meanwhile
      ta.value = src;
      langSel.value = "typescript";
      render();
      save();
    }).catch(function () { /* stays a blank editor */ });
  }

  var isTouch = ("ontouchstart" in window) || (navigator.maxTouchPoints > 0);
  if (!isTouch && document.activeElement !== ta) ta.focus();
  render();
})();
</script>
</body>
</html>
