<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pied Piper — Middle-Out Compression</title>
<meta name="description" content="Pied Piper: the middle-out, decentralized compression platform. Fan-made educational tribute." />
<link rel="icon" type="image/webp" href="assets/piedpiperoldlogo.webp" />
<link rel="stylesheet" href="styles.css" />
</head>
<body>
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <img src="assets/piedpiperoldlogo.webp" alt="Pied Piper logo" />
      <span>Pied Piper</span>
    </a>
    <nav class="links">
      <a href="#middleout">Middle-Out</a>
      <a href="#demo">Live Demo</a>
      <a href="#platform">Platform</a>
