{"topic":"HTML forms","source":"https://www.w3schools.com/html/html_forms.asp","examples":[{"name":"text fields with labels","code":"<form>\n  <label for=\"fname\">First name:</label><br>\n  <input type=\"text\" id=\"fname\" name=\"fname\"><br>\n  <label for=\"lname\">Last name:</label><br>\n  <input type=\"text\" id=\"lname\" name=\"lname\">\n</form>"},{"name":"radio group, one choice","code":"<p>Choose your favorite Web language:</p>\n<form>\n  <input type=\"radio\" id=\"html\" name=\"fav_language\" value=\"HTML\">\n  <label for=\"html\">HTML</label><br>\n  <input type=\"radio\" id=\"css\" name=\"fav_language\" value=\"CSS\">\n  <label for=\"css\">CSS</label><br>\n  <input type=\"radio\" id=\"javascript\" name=\"fav_language\" value=\"JavaScript\">\n  <label for=\"javascript\">JavaScript</label>\n</form>"},{"name":"submit to a handler","code":"<form action=\"/action_page.php\">\n  <label for=\"fname\">First name:</label><br>\n  <input type=\"text\" id=\"fname\" name=\"fname\" value=\"John\"><br>\n  <label for=\"lname\">Last name:</label><br>\n  <input type=\"text\" id=\"lname\" name=\"lname\" value=\"Doe\"><br><br>\n  <input type=\"submit\" value=\"Submit\">\n</form>"}],"rules":["label for must equal input id to bind them","every submittable input needs a name attribute or its value is never sent","one shared radio name means one choice","form action points at the server-side handler"]}