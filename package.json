    "fast-xml-parser": "^4.4.0",
    "helmet": "^7.1.0",
    "jsdom": "^27.2.0",
    "morgan": "^1.10.0",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
